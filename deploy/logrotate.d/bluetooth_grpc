/var/log/bluetooth_grpc_init {
    rotate 4
    size 100M
    compress
    delaycompress
    create
    missingok
    notifempty
    copytruncate
}

/var/log/bluetooth_test_server.log {
    rotate 4
    size 100M
    compress
    delaycompress
    create
    missingok
    notifempty
    copytruncate
}
