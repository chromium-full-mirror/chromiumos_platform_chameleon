/var/log/chameleon_commits {
    rotate 4
    size 1M
    compress
    delaycompress
    create
    missingok
    notifempty
}

/var/log/chameleond_init {
    rotate 4
    size 3M
    compress
    delaycompress
    create
    missingok
    notifempty
}

/var/log/chameleond {
    rotate 4
    size 3M
    compress
    delaycompress
    create
    missingok
    notifempty
}
