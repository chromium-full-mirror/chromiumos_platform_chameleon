flash_ec_from_pkgver() {
  pacman_version=$1 # includes -pkgrel
  # crop it, since ec filename does not include it
  # and use - instead of _ since that's how the .bin is named
  version=$(echo ${pacman_version%-*}|sed "s/_/-/g")
  filename="/boot/${version}.bin"

  flash_ec ${filename}
}

post_install() {
  flash_ec_from_pkgver $1
}

post_upgrade() {
  flash_ec_from_pkgver $1
}
