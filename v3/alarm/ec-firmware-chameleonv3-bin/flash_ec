#!/bin/bash

set -o errexit # percolate errors (eg: flashing ones) upwards to pacman

filename=$1
if [ -z "${filename}" ]; then
  echo "You need to provide a filename. Maybe one of:"
  ls -1 /boot/*.bin *.bin 2>/dev/null
  exit 1
fi

echo "Preparing to flash EC with ${filename}"

if [[ -z "$(gpioinfo STM32_BOOT0)" ]]; then
  echo "Can't find STM32_BOOT0. Not on a chameleon?"
  # still call it a "success" as we might be in a chroot
  # preparing the sd card image
  exit 0
fi

if [[ -z "$(gpioinfo STM32_RST_L)" ]]; then
  echo "Can't find STM32_RST_L. Not on a chameleon?"
  exit 0
fi

echo "Flashing!"
( set -o xtrace ; # let's be dramatic by printing the commands
  systemctl kill chameleond
  gpioset -t0 -d open-source --by-name STM32_BOOT0=1 # program
  gpioset -t0 -d open-drain --by-name STM32_RST_L=0
  gpioset -t0 -d open-drain --by-name STM32_RST_L=1
  stm32flash -f /dev/ttyS0 -w ${filename} -v -S 0x8000000 -b 1000000
  gpioset -t0 -d open-source --by-name STM32_BOOT0=0 # normal mode
  gpioset -t0 -d open-drain --by-name STM32_RST_L=0
  gpioset -t0 -d open-drain --by-name STM32_RST_L=1
  systemctl start chameleond
)
