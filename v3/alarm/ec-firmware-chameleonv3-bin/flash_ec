#!/bin/bash

filename=$1
if [ -z "${filename}" ]; then
  echo "You need to provide a filename. Maybe one of:"
  ls -1 /boot/*.bin *.bin 2>/dev/null
  exit 1
fi

echo "Preparing to flash EC with ${filename}"

if ! boot0=$(gpiofind STM32_BOOT0); then
  echo "Can't find STM32_BOOT0. Not on a chameleon?"
  return
fi

if ! rst_l=$(gpiofind STM32_RST_L); then
  echo "Can't find STM32_RST_L. Not on a chameleon?"
  return
fi

echo "Flashing!"
( set -x ; # let's be dramatic by printing the commands
  systemctl kill chameleond
  gpioset -D open-source ${boot0}=1 # program
  gpioset -D open-drain ${rst_l}=0
  gpioset -D open-drain ${rst_l}=1
  stm32flash -f /dev/ttyS0 -w ${filename} -v -S 0x8000000 -b 1000000
  gpioset -D open-source ${boot0}=0 # normal mode
  gpioset -D open-drain ${rst_l}=0
  gpioset -D open-drain ${rst_l}=1
  systemctl start chameleond
)
