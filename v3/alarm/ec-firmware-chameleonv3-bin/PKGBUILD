# EC firmware image for Chameleon, repackaged from precompiled binary
# Maintainer: Alexandru M Stan <amstan@chromium.org>

# Before editing: see `v3/ec/release.sh` as it can update this automatically

buildarch=4

pkgname=ec-firmware-chameleonv3-bin
_version=v3-247-g50661cc
pkgver=$(echo ${_version}|sed "s/-/_/g")
pkgrel=1
provides=('ec-firmware-chameleonv3')
pkgdesc="EC Firmware for Chameleon v3"
arch=('armv7h')
url='https://chromium.googlesource.com/chromiumos/platform/chameleon/+/refs/heads/main/v3/ec/'
license=('Custom')
optdepends=('libgpiod: access the EC bootloader pins'
            'stm32flash: speaks the bootloader protocol to flash the image')
source=("https://storage.googleapis.com/chromeos-hardware-tools-chameleon-v3/intermediate/ec/${_version}.bin"
        'flash_ec')
sha256sums=('84a0b9caa6769c5e0d2df0c46bfd070c1162eb1f6ad686c93e23e81b7422dd78'
            '2d25f5f12b8d387a26c6310d7ea697531228aeaa2f32c9f393d37975a7dba464')

# build() {
  # For now we'll just pre-build the image and include it in the source= array
  # In the future we could run `west build -b chameleon` in here
  # See b/246684278#comment1
# }

package() {
  install=ec.install
  install *.bin -Dt "${pkgdir}"/boot/
  install flash_ec -Dt "${pkgdir}"/usr/bin
}
