# FPGA Bitstream for Chameleon v3
# Maintainer: Alexandru M Stan <amstan@chromium.org>

buildarch=4

_version=v3-184-gcf50534
pkgname=fpga-bitstream-chameleonv3
pkgver=$(echo ${_version}|sed "s/-/_/g")
pkgrel=1
pkgdesc="FPGA Bitstream for Chameleon v3"
arch=('armv7h')
url='https://chromium.googlesource.com/chromiumos/platform/chameleon/+/refs/heads/main/v3/fpga/'
license=('BSD')
provides=('fpga-bitstream')
_fpga_types=(
  '270-2'
  '480-2'
)
for type in "${_fpga_types[@]}"; do
  source+=("https://storage.googleapis.com/chromeos-hardware-tools-chameleon-v3/intermediate/fpga/${_version}-${type}.itb");
done
sha256sums=('a92411f0ef621940d609dfa114b8f47c93a233f6bb63e02896c58c674fb42cbd'
            'f19863ed55e9925948aaecfc9660a98aeae623d88cdcf954afe0aeec51a3d980')

build() {
  # rbf->itb already done by the fpga synthesis scripts

  # rename .itb files to have fpga- in the name
  for file in *.itb; do
    mv $file fpga-$file
  done
}

package() {
  install fpga-*.itb -Dt "${pkgdir}"/boot/

  # Make links to the latest version so u-boot doesn't need to know the
  # particular version numbered filename but can still get to it.
  cd "${pkgdir}"/boot/
  for type in "${_fpga_types[@]}"; do
    ln -s fpga-${_version}-${type}.itb fpga-${type}.itb
  done
}
