# U-Boot: Chameleon
# Maintainer: Alexandru M Stan <amstan@chromium.org>

buildarch=4

FPGA_TYPE_DEFAULT=270_2
# FPGA_TYPE_DEFAULT=270_3
# FPGA_TYPE_DEFAULT=480_2
FPGA_TYPE=${FPGA_TYPE:=${FPGA_TYPE_DEFAULT}}

pkgname=uboot-chameleonv3-${FPGA_TYPE}
pkgver=v2023.10_next
pkgrel=2 # This needs to be incremented with every change to this file
_commit=923f25080339770806369e41767f8d0464f2b451 # FROMLIST: chameleonv3: set in defconfig for FPGA to reprogram every reboot
provides=('uboot-chameleonv3')
conflicts=('uboot-chameleonv3')
pkgdesc="U-Boot for Chameleon v3"
arch=('armv7h')
url='https://chromium.googlesource.com/chromiumos/third_party/u-boot/'
license=('GPL2')
makedepends=('bc' 'dtc')
optdepends=('linux: need to boot a kernel'
            'fpga-bitstream: Required to configure the Arria10 SOC so we can boot')
source=("https://chromium.googlesource.com/chromiumos/third_party/u-boot/+archive/${_commit}.tar.gz"
        'u-boot.txt')
sha256sums=('SKIP' # gerrit produces non reproducible archives
            '77134caf541130a38870881f903f33bfae39b04eeead126edd16c2ae5757b412')

build() {
  make distclean
  make socfpga_chameleonv3_defconfig
  make EXTRAVERSION=-${pkgrel} DEVICE_TREE=socfpga_arria10_chameleonv3_${FPGA_TYPE}
}

package() {
  install=u-boot.install

  install ../u-boot.txt -Dt "${pkgdir}"/boot/

  install u-boot.img -Dt "${pkgdir}"/boot/
  install spl/u-boot-splx4.sfp -Dt "${pkgdir}"/boot/
}
