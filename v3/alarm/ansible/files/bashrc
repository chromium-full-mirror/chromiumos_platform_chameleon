#
# ~/.bashrc
#

# If not running interactively, don't do anything
[[ $- != *i* ]] && return

alias ls='ls --color=auto'

# fix history to be long and to remember better
shopt -s histappend
PROMPT_COMMAND='history -a'

# official "chameleon green" prompt
PS1='\[\033[00;32m\]\u@\h\[\033[00m\]:\[\033[01;32m\]\w\[\033[01;33m\]\$\[\033[00m\] '
