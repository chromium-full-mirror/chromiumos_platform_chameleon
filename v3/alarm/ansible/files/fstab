# Static information about the filesystems.
# See fstab(5) for details.

# <file system> <dir> <type> <options> <dump> <pass>

# Probably /dev/mmcblk0p3
LABEL=chameleon_fs   /       btrfs rw,relatime,ssd,space_cache=v2,subvol=/root,discard=async  0 0
LABEL=chameleon_fs   /mnt/fs btrfs rw,relatime,ssd,space_cache=v2,subvol=/,discard=async      0 0

# /dev/mmcblk0p1
LABEL=chameleon_boot /boot   ext4  rw,relatime     0 2
