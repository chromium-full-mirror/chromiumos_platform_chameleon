recursive-include updatable boot-partition.img fpga.rbf socfpga.dtb zImage modules.tgz
# The following are servod dependencies for measuring power consumption.
include usr/lib64/python-exec/python2.7/dut-control
include usr/lib64/python-exec/python2.7/servod
graft usr/share/servo_updater
