include usr/lib64/python2.7/site-packages/servo_updater.py
graft usr/lib64/python2.7/site-packages/servo_updater-*.egg-info
graft usr/lib64/python2.7/site-packages/usb
graft usr/lib64/python2.7/site-packages/ec3po
graft usr/lib64/python2.7/site-packages/ec3po-*.egg-info
graft usr/lib64/python2.7/site-packages/servo
graft usr/lib64/python2.7/site-packages/servo-*.egg-info
graft usr/lib64/python2.7/site-packages/ecusb
graft usr/lib64/python2.7/site-packages/ecusb-*.egg-info
