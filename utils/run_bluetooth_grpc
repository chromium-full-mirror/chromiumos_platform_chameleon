"""Run Bluetooth GRPC Daemon."""

import argparse
import logging
import asyncio
import sys

from chameleond.bluetooth_grpc.server.server import start_bluetooth_test_server

def handle_exception(exc_type, exc_value, exc_traceback):
    """Custom exception handler to log unhandled exceptions."""
    if issubclass(exc_type, KeyboardInterrupt):
        # Don't log KeyboardInterrupt
        sys.__excepthook__(exc_type, exc_value, exc_traceback)
        return

    logging.error(
        "Unhandled exception caught:",
        exc_info=(exc_type, exc_value, exc_traceback),  # Log exception info
    )

def main():
  """The Main program, to run Bluetooth GRPC Daemon."""

  for handler in logging.root.handlers[:]:
    logging.root.removeHandler(handler)

  parser = argparse.ArgumentParser(
      description='Launch a Bluetooth GRPC daemon.',
      formatter_class=argparse.ArgumentDefaultsHelpFormatter)

  parser.add_argument('--log', type=str, dest='log', metavar='PATH',
                      default='/var/log/bluetooth_test_server.log',
                      help='write log to this file or - to stderr')
  parser.add_argument('--host', type=str, dest='host', default='::',
                      help='host address of RPC server')
  parser.add_argument('--port', type=int, dest='port', default=8999,
                      help='port number of RPC server')
  parser.add_argument('-v', '--verbose', action='count', dest='verbose',
                      default=0, help='increase message verbosity')

  options = parser.parse_args()

  verbosity_map = {0: logging.INFO, 1: logging.DEBUG}
  verbosity = verbosity_map.get(options.verbose or 0, logging.NOTSET)

  log_format = '%(asctime)s %(levelname)-8s '
  if options.verbose > 0:
    log_format += '(%(filename)s:%(lineno)d) '
  log_format += '%(message)s'

  log_config = {
    'level': verbosity,
    'format': log_format,
    'datefmt': "%Y-%m-%d %H:%M:%S",
  }

  if options.log != '-':
    log_config.update({'filename': options.log})
  logging.basicConfig(**log_config)
  # Set the custom exception hook
  sys.excepthook = handle_exception

  asyncio.run(start_bluetooth_test_server(options.port))

if __name__ == '__main__':
  main()
